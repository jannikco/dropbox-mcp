              "schema": {
                "type": "object",
                "properties": {},
                "required": []
              }
            }
          }
        }
      }
    },
    "/files/list_folder": {
      "post": {
        "operationId": "list_folder",
        "summary": "Read folder entries using a user-authorized path. Empty path lists the root.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "",
                    "default": ""
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000
                  },
                  "recursive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          }
        }
      }
    },
    "/files/list_folder/continue": {
      "post": {
        "operationId": "continue_folder_listing",
        "summary": "Read the next folder page using a cursor returned by list_folder.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cursor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "description": "Identifier"
                  }
                },
                "required": [
                  "cursor"
                ]
              }
            }
          }
        }
      }
    }
