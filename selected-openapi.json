    }
  ],
  "paths": {
    "/users/get_current_account": {
      "post": {
        "operationId": "get_current_account",
        "summary": "Read the authorized Dropbox account.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
